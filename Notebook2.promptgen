n",")\n","\n","row_num = 2\n","\n","for i, ex in enumerate(subset):\n","\n","    gt = ex[\"answer\"][0]\n","    img = ex[\"image\"].convert(\"RGB\")\n","\n","    # save thumbnail temporarily\n","    thumb_path = f\"/content/thumb_{i}.png\"\n","    img.thumbnail((128, 128))\n","    img.save(thumb_path)\n","\n","    ws.append([\n","        ex[\"question_id\"],\n","        ex[\"file_name\"],\n","        gt,\n","        implicit_prompt,\n","        explicit_prompt,\n","        cot_prompt,\n","        \"\"  # placeholder for image\n","    ])\n","\n","    # Insert thumbnail\n","    xl_img = XLImage(thumb_path)\n","    xl_img.width = 80\n","    xl_img.height = 80\n","    ws.add_image(xl_img, f\"G{row_num}\")\n","\n","    row_num += 1\n","\n","# Save Excel\n","excel_path = \"/content/image_prompts_with_thumbnails.xlsx\"\n","wb.save(excel_path)\n","\n","excel_path"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":35},"id":"40jANXoCSkBz","executionInfo":{"status":"ok","timestamp":1764078803922,"user_tz":-330,"elapsed":3315,"user":{"displayName":"Sai Sannidhi Akepati","userId":"08778717453847889673"}},"outputId":"809a1f34-dfaf-46c8-9985-7891ea2ceacd"},"execution_count":16,"outputs":[{"output_type":"execute_result","data":{"text/plain":["'/content/image_prompts_with_thumbnails.xlsx'"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"string"}},"metadata":{},"execution_count":16}]}]}