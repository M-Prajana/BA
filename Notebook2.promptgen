ip install -q datasets"],"metadata":{"id":"S3yjZNlhIds4","executionInfo":{"status":"ok","timestamp":1764076163272,"user_tz":-330,"elapsed":5997,"user":{"displayName":"Sai Sannidhi Akepati","userId":"08778717453847889673"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","execution_count":6,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6-tsAv8LP-2c","executionInfo":{"status":"ok","timestamp":1764076265566,"user_tz":-330,"elapsed":421,"user":{"displayName":"Sai Sannidhi Akepati","userId":"08778717453847889673"}},"outputId":"61531ace-1779-41d0-a4fc-24bd470e9b9d"},"outputs":[{"output_type":"stream","name":"stdout","text":["Archive:  coco_subset_200.zip\n","   creating: coco_subset_200/\n","  inflating: coco_subset_200/dataset_info.json  \n","   creating: coco_subset_200/.ipynb_checkpoints/\n","  inflating: coco_subset_200/state.json  \n","  inflating: coco_subset_200/data-00000-of-00001.arrow  \n"]}],"source":["!unzip coco_subset_200.zip"]},{"cell_type":"code","source":["from datasets import load_from_disk\n","\n","subset = load_from_disk(\"/content/coco_subset_200\")\n","print(\"Loaded subset, examples:\", len(subset))\n","# show one example to confirm\n","display(subset[0])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":295},"id":"locYYv7_TXLP","executionInfo":{"status":"ok","timestamp":1764076271565,"user_tz":-330,"elapsed":69,"user":{"displayName":"Sai Sannidhi Akepati","userId":"08778717453847889673"}},"outputId":"4f4e3869-9132-4184-862a-ffeacb9f77e8"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Loaded subset, examples: 200\n"]},{"output_type":"display_data","data":{"text/plain":["{'question_id': '000000561009.jpg',\n"," 'image': <PIL.JpegImagePlugin.JpegImageFile image mode=RGB size=640x427>,\n"," 'question': 'Please carefully observe the image and come up with a caption for the image.',\n"," 'answer': ['A bird perched on top of a tree branch.',\n","  'A brown bird has a small yellow head.',\n","  'A bird with brown wings and head perched in a tree.',\n","  'A bird that is perched in a tree.',\n","  'A bird sits perched on a tree branch.'],\n"," 'id': 698182,\n"," 'license': 2,\n"," 'file_name': '000000561009.jpg',\n"," 'coco_url': 'http://images.cocodataset.org/val2017/000000561009.jpg',\n"," 'height': 427,\n"," 'width': 640,\n"," 'date_captured': '2013-11-17 03:42:29'}"]},"metadata":{}}]},{"cell_type":"code","source":["implicit_prompt = \"Describe the image.\"\n","\n","explicit_prompt = (\n","    \"Describe all objects, colors, actions, and spatial relationships in the image \"\n","    \"in clear and complete sentences.\"\n",")\n","\n","cot_prompt = (\n","    \"Think step-by-step about the image:\\n\"\n","    \"1. Identify all visible objects.\\n\"\n","    \"2. Describe their attributes (color, size, shape).\\n\"\n","    \"3. Explain spatial relationships between objects.\\n\"\n","    \"4. Identify any actions or interactions.\\n\"\n","    \"5. Infer the overall scene context.\\n\"\n","    \"6. Provide a final concise summary.\"\n",")"],"metadata":{"id":"2QrMayALJCTZ","executionInfo":{"status":"ok","timestamp":1764076303583,"user_tz":-330,"elapsed":45,"user":{"displayName":"Sai Sannidhi Akepati","userId":"08778717453847889673"}}},"execution_count":8,"outputs":[]},{"cell_type":"code","source":["def add_prompts(example):\n","    # Keep ground_truth exactly as the first human caption (do not modify)\n","    gt = example.get(\"clean_caption\") if example.get(\"clean_caption\") else example[\"answer\"][0].strip()\n","\n","    example[\"implicit_prompt\"] = implicit_prompt\n","    example[\"explicit_prompt\"] = explicit_prompt\n","    example[\"cot_prompt\"] = cot_prompt\n","    example[\"ground_truth\"] = gt\n","    return example\n","\n","# Apply map (batched=False preserves PIL images correctly)\n","stage1 = subset.map(add_prompts)\n","# quick sanity check\n","print(stage1.features)\n","display(stage1[0])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":434,"referenced_widgets":["b55f1112b63643ed9ef6fc8ae90cc1b7","db5a8d00da6c4b55a943478a3b7ee379","a323868e9a834bd086d2aa72dfcccb32","ce52755d04ca4b38800f7bfdb2068f34","c523beae6cb54a92868c5f7b4a5052e0","ba1d9f6028f042fc890b5d6c407d78ce","aaa5110e53ef44c599e305c7007704ad","69503675f5704fbdb3e8d294e771daca","33a0d17b5fd7413e8ca427a10fa12fe5","0180a28497174b90867a0ed1b8742be9","d3b5db4f32b747f88e5786994bb8ace1"]},"id":"HRQWFkoSJx8T","executionInfo":{"status":"ok","timestamp":1764076508663,"user_tz":-330,"elapsed":85,"user":{"displayName":"Sai Sannidhi Akepati","userId":"08778717453847889673"}},"outputId":"0decca84-672a-4ea2-dc2f-cf888dfa37a9"},"execution_count":9,"outputs":[{"output_type":"display_data","data":{"text/plain":["Map:   0%|          | 0/200 [00:00<?, ? examples/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"b55f1112b63643ed9ef6fc8ae90cc1b7"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["{'question_id': Value('string'), 'image': Image(mode=None, decode=True), 'question': Value('string'), 'answer': List(Value('string')), 'id': Value('int64'), 'license': Value('int8'), 'file_name': Value('string'), 'coco_url': Value('string'), 'height': Value('int32'), 'width': Value('int32'), 'date_captured': Value('string'), 'implicit_prompt': Value('string'), 'explicit_prompt': Value('string'), 'cot_prompt': Value('string'), 'ground_truth': Value('string')}\n"]},{"output_type":"display_data","data":{"text/plain":["{'question_id': '000000561009.jpg',\n"," 'image': <PIL.JpegImagePlugin.JpegImageFile image mode=RGB size=640x427>,\n"," 'question': 'Please carefully observe the image and come up with a caption for the image.',\n"," 'answer': ['A bird perched on top of a tree branch.',\n","  'A brown bird has a small yellow head.',\n","  'A bird with brown wings and head perched in a tree.',\n","  'A bird that is perched in a tree.',\n","  'A bird sits perched on a tree branch.'],\